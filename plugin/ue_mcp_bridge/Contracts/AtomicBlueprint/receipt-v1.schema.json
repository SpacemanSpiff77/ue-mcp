{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spacehead.blueprint-atomic-bridge.receipt@1.0",
  "x-spacehead-schema-version": "spacehead.blueprint-atomic-bridge.receipt@1.0",
  "title": "Spacehead atomic Blueprint bridge receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "transaction_id", "correlation_id", "received_by_bridge", "state", "evidence"],
  "properties": {
    "contract_version": { "const": "spacehead.blueprint-atomic-bridge@1.0" },
    "transaction_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "received_by_bridge": { "type": "boolean" },
    "received_at": { "type": "string", "format": "date-time" },
    "state": {
      "enum": ["FAILED_PRE_MUTATION", "QUARANTINED", "RESTORED", "SUCCESS", "UNKNOWN"]
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "required": ["attempted", "succeeded"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "target_resolved": { "type": "boolean" },
        "semantic_baseline_exact": { "type": "boolean" },
        "handler_version": { "type": "string" },
        "topology_version": { "type": "string" },
        "changed_pin_defaults": { "type": "integer", "minimum": 0, "maximum": 1 },
        "test_failure_injected": { "type": "boolean" },
        "fault_checkpoint": { "type": "string" },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "save_requested": { "const": false },
        "exact_expected_delta": { "type": "boolean" },
        "unchanged_invariants": { "type": "boolean" },
        "persisted_verified": { "type": "boolean" },
        "package_clean": { "type": "boolean" },
        "semantic_restoration_verified": { "type": "boolean" },
        "clean_state_restored": { "type": "boolean" },
        "persisted_state_uncertain": { "type": "boolean" },
        "compile": { "$ref": "#/$defs/attempt" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "dispatch_count": { "type": "integer", "minimum": 1, "maximum": 1 },
        "fault_checkpoint": { "type": "string" },
        "dirty_state": {
          "type": "object",
          "properties": {
            "before": { "type": "boolean" },
            "after_preflight": { "type": "boolean" },
            "final": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "preflight": { "$ref": "#/$defs/attempt" },
        "mutation": { "$ref": "#/$defs/attempt" },
        "compile": { "$ref": "#/$defs/attempt" },
        "verification": { "$ref": "#/$defs/attempt" },
        "save": { "$ref": "#/$defs/attempt" },
        "rollback": { "$ref": "#/$defs/attempt" },
        "pre_semantic_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "post_semantic_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_version", "phase", "code", "retryable", "transaction_state", "message"],
      "properties": {
        "failure_version": { "const": "spacehead.builder-failure@1.0" },
        "phase": {
          "enum": ["BASELINE", "CAPABILITY", "COMPILE", "CONCURRENCY", "DISPATCH", "INTERNAL_CONTRACT", "LIVE_PREFLIGHT", "MUTATION", "RECOVERY", "RESTART", "ROLLBACK", "SAVE", "SPEC", "TRANSPORT_UNKNOWN", "VERIFY"]
        },
        "code": { "type": "string", "minLength": 1 },
        "retryable": { "const": false },
        "transaction_state": {
          "enum": ["FAILED_PRE_MUTATION", "QUARANTINED", "RESTORED", "UNKNOWN"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
