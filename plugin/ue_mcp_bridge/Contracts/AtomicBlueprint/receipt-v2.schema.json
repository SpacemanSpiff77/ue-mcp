{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spacehead.blueprint-atomic-bridge.receipt@2.0",
  "x-spacehead-schema-version": "spacehead.blueprint-atomic-bridge.receipt@2.0",
  "title": "Spacehead bounded multi-operation Blueprint bridge receipt",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "transaction_id", "correlation_id", "received_by_bridge", "state", "evidence"],
  "properties": {
    "contract_version": { "const": "spacehead.blueprint-atomic-bridge@2.0" },
    "transaction_id": { "type": "string", "minLength": 1 }, "correlation_id": { "type": "string", "minLength": 1 },
    "received_by_bridge": { "type": "boolean" }, "received_at": { "type": "string" },
    "state": { "enum": ["FAILED_PRE_MUTATION", "QUARANTINED", "RESTORED", "SUCCESS", "UNKNOWN"] },
    "evidence": { "$ref": "#/$defs/evidence" }, "failure": { "$ref": "#/$defs/failure" }
  },
  "$defs": {
    "attempt": { "type": "object", "required": ["attempted", "succeeded"], "additionalProperties": true,
      "properties": { "attempted": { "type": "boolean" }, "succeeded": { "type": "boolean" } } },
    "terminalPinType": { "type": "object", "additionalProperties": false,
      "required": ["category", "subcategory", "subcategory_object", "const", "weak_reference", "uobject_wrapper"],
      "properties": {
        "category": { "type": "string" }, "subcategory": { "type": "string" },
        "subcategory_object": { "type": "string" }, "const": { "type": "boolean" },
        "weak_reference": { "type": "boolean" }, "uobject_wrapper": { "type": "boolean" }
      } },
    "pinType": { "type": "object", "additionalProperties": false,
      "required": ["category", "subcategory", "subcategory_object", "container", "reference", "const",
        "weak_reference", "uobject_wrapper", "map_value_type"],
      "properties": {
        "category": { "type": "string" }, "subcategory": { "type": "string" },
        "subcategory_object": { "type": "string" },
        "container": { "enum": ["scalar", "array", "set", "map"] },
        "reference": { "type": "boolean" }, "const": { "type": "boolean" },
        "weak_reference": { "type": "boolean" }, "uobject_wrapper": { "type": "boolean" },
        "map_value_type": { "$ref": "#/$defs/terminalPinType" }
      } },
    "connectionPin": { "type": "object", "additionalProperties": false,
      "required": ["node_identity", "pin_identity", "pin_name", "direction", "classification", "pin_type",
        "pre_linked", "pre_link_count"],
      "properties": {
        "node_identity": { "type": "string" }, "pin_identity": { "type": "string" },
        "pin_name": { "type": "string" }, "direction": { "enum": ["input", "output"] },
        "classification": { "enum": ["execution", "data"] }, "pin_type": { "$ref": "#/$defs/pinType" },
        "pre_linked": { "type": "boolean" }, "pre_link_count": { "type": "integer", "minimum": 0 }
      } },
    "connectionDecision": { "type": "object", "additionalProperties": false,
      "required": ["evidence_version", "profile", "operation_id", "schema_class", "unreal_response_enum",
        "unreal_response_code", "fatal", "diagnostic_code", "diagnostic_text", "from", "to",
        "structural_profile_match", "pins_clean", "try_create_connection_attempted",
        "try_create_connection_succeeded", "reciprocal_topology_verified", "outcome", "qualified",
        "rejection_reason_codes"],
      "properties": {
        "evidence_version": { "const": "spacehead.connection-decision-evidence@1.0" },
        "profile": { "const": "direct_exact_v1" }, "operation_id": { "type": "string", "minLength": 1 },
        "schema_class": { "type": "string" },
        "unreal_response_enum": { "enum": ["CONNECT_RESPONSE_MAKE", "CONNECT_RESPONSE_DISALLOW",
          "CONNECT_RESPONSE_BREAK_OTHERS_A", "CONNECT_RESPONSE_BREAK_OTHERS_B",
          "CONNECT_RESPONSE_BREAK_OTHERS_AB", "CONNECT_RESPONSE_MAKE_WITH_CONVERSION_NODE",
          "CONNECT_RESPONSE_MAKE_WITH_PROMOTION", "CONNECT_RESPONSE_MAX", "CONNECT_RESPONSE_UNKNOWN"] },
        "unreal_response_code": { "type": "integer" }, "fatal": { "type": "boolean" },
        "diagnostic_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "diagnostic_text": { "type": "string", "maxLength": 256 },
        "from": { "$ref": "#/$defs/connectionPin" }, "to": { "$ref": "#/$defs/connectionPin" },
        "structural_profile_match": { "type": "boolean" }, "pins_clean": { "type": "boolean" },
        "try_create_connection_attempted": { "type": "boolean" },
        "try_create_connection_succeeded": { "type": "boolean" },
        "reciprocal_topology_verified": { "type": "boolean" },
        "outcome": { "enum": ["QUALIFIED", "REJECTED"] }, "qualified": { "type": "boolean" },
        "rejection_reason_codes": { "type": "array", "uniqueItems": true, "maxItems": 8,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } }
      } },
    "operationResult": { "type": "object", "additionalProperties": true,
      "required": ["operation_id", "operation_type", "succeeded", "mutation_occurred"],
      "properties": { "operation_id": { "type": "string" }, "operation_type": { "type": "string" },
        "succeeded": { "type": "boolean" }, "mutation_occurred": { "type": "boolean" },
        "failure_code": { "type": "string" }, "resolved_identity": { "type": "object" },
        "connection_decision": { "$ref": "#/$defs/connectionDecision" } } },
    "evidence": { "type": "object", "additionalProperties": true,
      "properties": {
        "dispatch_count": { "const": 1 }, "operation_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "ordered_operation_ids": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "per_operation_results": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/operationResult" } },
        "connection_decisions": { "type": "array", "maxItems": 8,
          "items": { "$ref": "#/$defs/connectionDecision" } },
        "preflight": { "$ref": "#/$defs/attempt" }, "mutation": { "$ref": "#/$defs/attempt" },
        "compile": { "$ref": "#/$defs/attempt" }, "verification": { "$ref": "#/$defs/attempt" },
        "save": { "$ref": "#/$defs/attempt" }, "rollback": { "$ref": "#/$defs/attempt" },
        "pre_semantic_fingerprint": { "type": "string" }, "post_semantic_fingerprint": { "type": "string" }
      } },
    "failure": { "type": "object", "additionalProperties": false,
      "required": ["failure_version", "phase", "code", "retryable", "transaction_state", "message"],
      "properties": {
        "failure_version": { "const": "spacehead.builder-failure@1.0" }, "phase": { "type": "string" },
        "code": { "type": "string" }, "retryable": { "const": false },
        "transaction_state": { "enum": ["FAILED_PRE_MUTATION", "QUARANTINED", "RESTORED", "UNKNOWN"] },
        "message": { "type": "string" }
      } }
  }
}
